#!/bin/bash

# WireGuard Auto Setup Script
# Tự động cài đặt và cấu hình WireGuard VPN Server

set -e

echo "================================"
echo "WireGuard VPN Auto Setup Script"
echo "================================"
echo ""

# Kiểm tra quyền root
if [[ $EUID -ne 0 ]]; then
   echo "Script này cần chạy với quyền root (sudo)" 
   exit 1
fi

# Lấy IP công khai của server (IPv4)
echo "Đang lấy IP công khai của server..."
SERVER_IP=$(curl -4 -s ifconfig.me || curl -4 -s icanhazip.com || curl -4 -s api.ipify.org || dig +short myip.opendns.com @resolver1.opendns.com)
echo "IP Server: $SERVER_IP"
echo ""

# Lấy tên network interface chính
INTERFACE=$(ip route | grep default | awk '{print $5}' | head -n1)
echo "Network Interface: $INTERFACE"
echo ""

# Cài đặt WireGuard
echo "Cài đặt WireGuard..."
apt update
apt install wireguard qrencode -y

# Enable IP forwarding
echo "Bật IP forwarding..."
echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf
sysctl -p

# Tạo thư mục cấu hình
mkdir -p /etc/wireguard
cd /etc/wireguard

# Dừng WireGuard nếu đang chạy
echo "Dừng WireGuard nếu đang chạy..."
wg-quick down wg0 2>/dev/null || true

# Dọn dẹp iptables rules cũ
echo "Dọn dẹp iptables rules cũ..."
iptables -D FORWARD -i wg0 -j ACCEPT 2>/dev/null || true
iptables -t nat -D POSTROUTING -o $INTERFACE -j MASQUERADE 2>/dev/null || true

# Xóa file cấu hình cũ
echo "Xóa file cấu hình cũ..."
rm -f /etc/wireguard/wg0.conf
rm -f /etc/wireguard/client.conf

# Kiểm tra và tạo khóa cho Server
if [ -f "server_private.key" ] && [ -f "server_public.key" ]; then
    echo "Sử dụng lại khóa Server cũ..."
    SERVER_PRIVATE_KEY=$(cat server_private.key)
    SERVER_PUBLIC_KEY=$(cat server_public.key)
else
    echo "Tạo khóa mới cho Server..."
    wg genkey | tee server_private.key | wg pubkey > server_public.key
    chmod 600 server_private.key
    SERVER_PRIVATE_KEY=$(cat server_private.key)
    SERVER_PUBLIC_KEY=$(cat server_public.key)
fi

# Kiểm tra và tạo khóa cho Client
if [ -f "client_private.key" ] && [ -f "client_public.key" ]; then
    echo "Sử dụng lại khóa Client cũ..."
    CLIENT_PRIVATE_KEY=$(cat client_private.key)
    CLIENT_PUBLIC_KEY=$(cat client_public.key)
else
    echo "Tạo khóa mới cho Client..."
    wg genkey | tee client_private.key | wg pubkey > client_public.key
    chmod 600 client_private.key
    CLIENT_PRIVATE_KEY=$(cat client_private.key)
    CLIENT_PUBLIC_KEY=$(cat client_public.key)
fi

# Tạo file cấu hình Server
echo "Tạo cấu hình Server..."
cat > /etc/wireguard/wg0.conf << EOF
[Interface]
Address = 10.0.0.1/24
ListenPort = 51820
PrivateKey = $SERVER_PRIVATE_KEY
PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o $INTERFACE -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o $INTERFACE -j MASQUERADE

# Client 1
[Peer]
PublicKey = $CLIENT_PUBLIC_KEY
AllowedIPs = 10.0.0.2/32
EOF

# Tạo file cấu hình Client
echo "Tạo cấu hình Client..."
cat > /etc/wireguard/client.conf << EOF
[Interface]
PrivateKey = $CLIENT_PRIVATE_KEY
Address = 10.0.0.2/24
DNS = 8.8.8.8, 1.1.1.1

[Peer]
PublicKey = $SERVER_PUBLIC_KEY
Endpoint = $SERVER_IP:51820
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
EOF

# Cấu hình firewall (nếu có ufw)
if command -v ufw &> /dev/null; then
    echo "Cấu hình UFW firewall..."
    ufw allow 51820/udp
    ufw allow OpenSSH
fi

# Khởi động WireGuard
echo "Khởi động WireGuard..."
wg-quick up wg0
systemctl enable wg-quick@wg0

# Tạo QR code cho mobile
echo ""
echo "================================"
echo "QR Code cho Mobile Client:"
echo "================================"
qrencode -t ansiutf8 < /etc/wireguard/client.conf

echo ""
echo "================================"
echo "Hoàn tất cài đặt!"
echo "================================"
echo ""
echo "Thông tin Server:"
echo "  - Server IP: $SERVER_IP"
echo "  - Server Public Key: $SERVER_PUBLIC_KEY"
echo "  - VPN Network: 10.0.0.0/24"
echo ""
echo "File cấu hình đã được tạo tại:"
echo "  - Server: /etc/wireguard/wg0.conf"
echo "  - Client: /etc/wireguard/client.conf"
echo ""
echo "Để tải file client về máy:"
echo "  scp root@$SERVER_IP:/etc/wireguard/client.conf ."
echo ""
echo "Kiểm tra trạng thái:"
echo "  sudo wg show"
echo ""
echo "================================"

# Hiển thị trạng thái
wg show
